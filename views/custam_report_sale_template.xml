<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="custom_report_sale_template"
        inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@class='page']"
            position="replace">
            <div class="page border-top pt-2">
                <div class="oe_structure"/>

                <div class="row mb32"
                    style="font-size: small;">
                    <div class="col-4">
                        <h3 style="font-size: 20px;">
                            <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                                <span t-if="doc.state not in ['draft','sent']">Orden # </span>
                                <span t-if="doc.state in ['draft','sent']">Presupuesto # </span>
                            </t>
                            <t t-if="env.context.get('proforma', False) or is_pro_forma">
                                <span>Factura Pro-Forma # </span>
                            </t>
                            <span t-field="doc.name"/>
                        </h3>
                    </div>

                    <div class="col-4 mx-2"
                        id="informations">
                        <div t-if="doc.client_order_ref"
                            class="m-0">
                            <strong>Referencia:</strong>
                            <span class="m-0"
                                t-field="doc.client_order_ref"/>
                        </div>
                        <div t-if="doc.date_order and doc.state in ['draft','sent']"
                            class="m-0">
                            <strong>Fecha de Cotización:</strong>
                            <span class="m-0"
                                t-field="doc.date_order"/>
                        </div>
                        <div t-if="doc.user_id.name"
                            class="m-0">
                            <strong>Vendedor:</strong>
                            <span class="m-0"
                                t-field="doc.user_id"/>
                        </div>
                        <div name="payment_term"
                            t-if="doc.payment_term_id"
                            class="m-0">
                            <strong>Términos de Pago:</strong>
                            <span class="m-0"
                                t-field="doc.payment_term_id"/>
                        </div>
                        <div t-if="doc.validity_date and doc.state in ['draft', 'sent']"
                            class="m-0">
                            <strong>Fecha de Expiración:</strong>
                            <span class="m-0"
                                t-field="doc.validity_date"/>
                        </div>
                    </div>

                    <div class="col-4">
                        <div class="text-start">
                            <strong style="display: block; margin-bottom: 0;">Datos de cliente:</strong>
                        </div>
                        <div class="text-start"
                            style="display: block; margin-top: 0; padding-top: 0;">
                            <t t-set="partner"
                                t-value="doc.partner_id"/>
                            <span t-esc="partner.name"/>
                            <br/>
                            <t t-if="partner.street">
                                <span t-esc="partner.street"/>
                            </t>
                            <t t-if="partner.street2">
                                <span t-esc="partner.street2"/>
                            </t>
                            <t t-if="partner.city or partner.state_id">
                                <span t-esc="partner.city"/>
                                <t t-if="partner.state_id">,
                                    <span t-esc="partner.state_id.name"/>
                                </t>
                            </t>
                            <t t-if="partner.zip">
                                <span t-esc="partner.zip"/>
                            </t>
                            <t t-if="partner.country_id">
                                <span t-esc="partner.country_id.name"/>
                            </t>
                        </div>
                    </div>
                </div>


                <!-- Is there a discount on at least one line? -->
                <t t-set="lines_to_report"
                    t-value="doc._get_order_lines_to_report()"/>
                <t t-set="display_discount"
                    t-value="any(l.discount for l in lines_to_report)"/>

                <div class="oe_structure"/>
                <table class="table table-sm o_has_total_table table o_main_table table-borderless"
                    style="font-size: small;">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_description"
                                class="text-start">Descripción</th>
                            <th name="th_quantity"
                                class="text-end text-nowrap">Cantidad</th>
                            <th name="th_priceunit"
                                class="text-end text-nowrap">Precio Unitario</th>
                            <th name="th_discount"
                                t-if="display_discount"
                                class="text-end">
                                <span>Desc.%</span>
                            </th>
                            <th name="th_taxes"
                                class="text-end">Impuestos</th>
                            <th name="th_subtotal"
                                class="text-end">
                                <span>Importe</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">

                        <t t-set="current_subtotal"
                            t-value="0"/>

                        <t t-foreach="lines_to_report"
                            t-as="line">

                            <t t-set="current_subtotal"
                                t-value="current_subtotal + line.price_subtotal"/>

                            <tr t-att-class="'fw-bold o_line_section' if (line.display_type == 'line_section' or line.product_type == 'combo') else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type and line.product_type != 'combo'">
                                    <td name="td_name">
                                        <span t-field="line.name">Bacon Burger</span>
                                    </td>
                                    <td name="td_quantity"
                                        class="o_td_quantity text-end">
                                        <span t-field="line.product_uom_qty"
                                            class="text-nowrap">3</span>
                                        <span t-field="line.product_uom">units</span>
                                        <span t-if="line.product_packaging_id">
                                        (                                            <span t-field="line.product_packaging_qty"
                                                t-options="{&quot;widget&quot;: &quot;integer&quot;}"/>
                                            <span t-field="line.product_packaging_id"/>
                                        )
                                        </span>
                                    </td>
                                    <td name="td_priceunit"
                                        class="text-end text-nowrap">
                                        <span t-field="line.price_unit">3</span>
                                    </td>
                                    <td t-if="display_discount"
                                        class="text-end">
                                        <span t-field="line.discount">-</span>
                                    </td>
                                    <t t-set="taxes"
                                        t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                    <td name="td_taxes"
                                        t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                        <span t-out="taxes">Tax 15%</span>
                                    </td>
                                    <td t-if="not line.is_downpayment"
                                        name="td_subtotal"
                                        class="text-end o_price_total">
                                        <span t-field="line.price_subtotal">27.00</span>
                                    </td>
                                </t>
                                <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                                    <td name="td_section_line"
                                        colspan="99">
                                        <span t-field="line.name">A section title</span>
                                    </td>
                                    <t t-set="current_section"
                                        t-value="line"/>
                                    <t t-set="current_subtotal"
                                        t-value="0"/>
                                </t>
                                <t t-elif="line.display_type == 'line_note'">
                                    <td name="td_note_line"
                                        colspan="99">
                                        <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                    </td>
                                </t>
                            </tr>

                            <t t-if="current_section and (                                 line_last                                 or lines_to_report[line_index+1].display_type == 'line_section'                                 or lines_to_report[line_index+1].product_type == 'combo'                                 or (                                     line.combo_item_id                                     and not lines_to_report[line_index+1].combo_item_id                                 )                             ) and not line.is_downpayment">
                                <t t-set="current_section"
                                    t-value="None"/>
                                <tr class="is-subtotal text-end">
                                    <td name="td_section_subtotal"
                                        colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span t-out="current_subtotal"
                                            t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}">31.05</span>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
                <div class="clearfix"
                    name="so_total_summary"
                    style="font-size: small;">
                    <div id="total"
                        class="row mt-n3"
                        name="total">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                            <table class="o_total_table table table-sm table-borderless">
                                <!-- Tax totals -->
                                <t t-call="sale.document_tax_totals">
                                    <t t-set="tax_totals"
                                        t-value="doc.tax_totals"/>
                                    <t t-set="currency"
                                        t-value="doc.currency_id"/>
                                </t>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="oe_structure"/>

                <div t-if="not doc.signature"
                    class="oe_structure"/>
                <div t-else=""
                    class="mt-4 ml64 mr4"
                    name="signature">
                    <div class="offset-8">
                        <strong>Firma</strong>
                    </div>
                    <div class="offset-8">
                        <img t-att-src="image_data_uri(doc.signature)"
                            style="max-height: 4cm; max-width: 8cm;"/>
                    </div>
                    <div class="offset-8 text-center">
                        <span t-field="doc.signed_by">Oscar Morgan</span>
                    </div>
                </div>
                <div>
                    <span t-field="doc.note"
                        t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}"
                        name="order_note"/>
                    <p t-if="not is_html_empty(doc.payment_term_id.note)">
                        <span t-field="doc.payment_term_id.note">El pago también debe transmitirse con cariño</span>
                    </p>
                    <div class="oe_structure"/>
                    <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)"
                        id="fiscal_position_remark">
                        <strong>Observación de la Posición Fiscal:</strong>
                        <span t-field="doc.fiscal_position_id.sudo().note">No hay requisitos adicionales para este pago</span>
                    </p>
                </div>

                <div class="oe_structure"/>
            </div>
        </xpath>
    </template>

    <template id="address_layout"
        inherit_id="web.address_layout">
        <xpath expr="//div[@name='address']"
            position="attributes">
            <attribute name="t-att-class">'ml-2'</attribute>
        </xpath>
    </template>

    <template id="external_layout_boxed"
        inherit_id="web.external_layout_boxed">
        <xpath expr="//t[@t-call='web.address_layout']"
            position="replace"></xpath>
    </template>

    <template id="external_layout_standard"
        inherit_id="web.external_layout_standard">
        <xpath expr="//t[@t-call='web.address_layout']"
            position="replace"></xpath>
    </template>

    <template id="external_layout_bold"
        inherit_id="web.external_layout_bold">
        <xpath expr="//t[@t-call='web.address_layout']"
            position="replace"></xpath>
    </template>

    <template id="external_layout_bubble"
        inherit_id="web.external_layout_bubble">
        <xpath expr="//t[@t-call='web.address_layout']"
            position="replace"></xpath>
    </template>

    <template id="external_layout_folder"
        inherit_id="web.external_layout_folder">
        <xpath expr="//t[@t-call='web.address_layout']"
            position="replace"></xpath>
    </template>

    <template id="external_layout_striped"
        inherit_id="web.external_layout_striped">
        <xpath expr="//t[@t-call='web.address_layout']"
            position="replace"></xpath>
    </template>

    <template id="external_layout_wave"
        inherit_id="web.external_layout_wave">
        <xpath expr="//t[@t-call='web.address_layout']"
            position="replace"></xpath>
    </template>
</odoo>